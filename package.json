{
  "name": "terepasztal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tools vite.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,json,css}\" index.html \"tools/**/*.{mjs,ts}\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,json,md}\" \".claude/**/*.{md,js,json}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "pack-atlas": "node tools/pack-atlas.mjs",
    "art:illustrated": "node tools/illustrated-sprites.mjs",
    "art:terrain": "node tools/terrain-surfaces.mjs",
    "art:buildings:guides": "node tools/building-guides.mjs",
    "art:buildings:queue": "node tools/building-queue.mjs",
    "art:buildings:check": "node tools/building-check.mjs",
    "art:buildings:sheets": "node tools/building-sheets.mjs",
    "art:buildings:fit": "node tools/building-fit.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,json,css}\" index.html \"tools/**/*.{mjs,ts}\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,json,md}\" \".claude/**/*.{md,js,json}\""
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@pixi/devtools": "^2.0.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^14.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.0"
  }
}
